# Copy to .env and fill in. Never commit .env.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Daily Gemini video allowance in seconds (free tier limit is 8 h of YouTube video/day)
GEMINI_DAILY_VIDEO_SECONDS=25200
# Max seconds per Gemini request for normal/high detail
WATCH_CHUNK_SECONDS=180
# YT_SCOUT_DB=~/.yt-scout/cache.db
