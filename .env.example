# Copy to .env and fill in. Never commit .env.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
# Model for normal/high detail (3.7 Flash won our 2026-10-04 benchmark)
GEMINI_MODEL=gemini-3.7-flash
# Optional faster model used only for detail="skim" (blank = same as GEMINI_MODEL)
GEMINI_SKIM_MODEL=gemini-3.5-flash-lite
# Daily Gemini video allowance in seconds (free tier limit is 8 h of YouTube video/day)
GEMINI_DAILY_VIDEO_SECONDS=25200
# Max seconds per Gemini request for normal/high detail
WATCH_CHUNK_SECONDS=180
# YT_SCOUT_DB=~/.yt-scout/cache.db
